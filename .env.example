# 이 파일을 .env 로 복사해 값을 채운다. .env 는 commit하지 않는다.
# EXPO_PUBLIC_* 값은 client bundle에 공개되므로 server secret을 넣지 않는다.
# Android emulator에서 local backend를 쓸 때만 http://10.0.2.2:8080으로 바꾼다.
EXPO_PUBLIC_API_BASE_URL=https://api.allog-app.store

# 레거시 Vite web build 전용이며 canonical Expo app은 읽지 않는다.
VITE_API_BASE_URL=http://localhost:8080
