# 이 파일을 .env 로 복사해 값을 채운다. .env 는 .gitignore 가 막고 있다.
#
# EXPO_PUBLIC_ 접두사가 붙은 값만 클라이언트 번들에 주입된다. 즉 이 값들은
# 앱을 뜯으면 보이는 공개 설정이다. 서버 secret(Firebase 서비스 계정 JSON,
# AWS 키, OPENAI/ANTHROPIC 키)은 절대 여기 넣지 않는다.
#
# ── Firebase 값을 어디서 가져오는가 ─────────────────────────────
# 백엔드가 주는 값이 아니다. 둘 중 하나에서 온다.
#
#   A) Firebase Console → 프로젝트 설정 → 내 앱
#      웹 앱의 firebaseConfig 에서 apiKey / authDomain / projectId / appId
#
#   B) Android 앱의 google-services.json
#      project_info.project_id            → EXPO_PUBLIC_FIREBASE_PROJECT_ID
#      client[0].api_key[0].current_key   → EXPO_PUBLIC_FIREBASE_API_KEY
#      client[0].client_info.mobilesdk_app_id → EXPO_PUBLIC_FIREBASE_APP_ID
#      AUTH_DOMAIN 은 <project_id>.firebaseapp.com 형식이다
#
# ★ 네 값이 모두 채워져야 Firebase 가 초기화된다. 하나라도 비면
#   src/services/firebase.js 가 초기화를 건너뛰고 로그인이 비활성 상태가 된다.
#
# ★ EXPO_PUBLIC_FIREBASE_PROJECT_ID 는 백엔드의 FIREBASE_PROJECT_ID 와
#   반드시 같은 프로젝트여야 한다. 다르면 "로그인은 되는데 서버가 401" 이라는
#   가장 헷갈리는 증상이 나온다.
#
# 값이 없으면 Firebase Console 접근 권한을 요청하는 게 맞다.
# 채워진 .env 를 사람 간에 주고받는 것보다 안전하고 추적 가능하다.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Expo API base URL. If unset, the app returns a network error without sending a request.
# Production default; use 10.0.2.2 only for a local Android emulator backend.
EXPO_PUBLIC_API_BASE_URL=https://api.allog-app.store

# 아래 VITE_*는 레거시 웹(Vite) 빌드 전용이며 RN 앱은 읽지 않는다.
VITE_API_BASE_URL=http://localhost:8080
