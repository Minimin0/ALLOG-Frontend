# Firebase — RN(Expo)은 EXPO_PUBLIC_ 접두사만 클라이언트에 주입됨, 웹(Vite)은 VITE_ 접두사.
# 백엔드에서 키 받으면 .env 파일 만들어 아래 값을 채우세요.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# RN(Expo) 앱이 백엔드를 찾는 주소. src/services/api.js가 이 값을 읽고, 없으면
# http://localhost:8080으로 떨어진다. Android에서 localhost는 "기기 자신"이라
# 개발 PC의 백엔드에 닿지 않으므로 이 값을 비워두면 안 된다.
#   - Android 에뮬레이터 → 호스트 PC : http://10.0.2.2:8080
#   - 실제 Android 기기   → 10.0.2.2가 아니라 개발 PC의 LAN IP
#                          (예: http://192.168.0.10:8080) 또는 배포된 HTTPS URL
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# 아래 VITE_*는 레거시 웹(Vite) 빌드 전용이며 RN 앱은 읽지 않는다.
VITE_API_BASE_URL=http://localhost:8080
