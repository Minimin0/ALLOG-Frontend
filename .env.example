# Expo(React Native)는 EXPO_PUBLIC_ 접두사가 붙은 값만 클라이언트에 주입한다.
# 이 값들은 앱 번들에 그대로 들어가는 공개 client configuration이다.
# 서버 secret(Firebase service account JSON, AWS 키, ANTHROPIC/OPENAI 키)은 절대 넣지 않는다.
#
# .env.example을 복사해 .env로 만들고 값을 채우세요.

# ALLOG 백엔드 주소. production URL을 코드에 하드코딩하지 않고 반드시 여기서 주입한다.
# Android 에뮬레이터에서 로컬 백엔드를 볼 때는 10.0.2.2를 쓴다 (localhost는 에뮬레이터 자신).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Firebase 웹 앱 설정 — 백엔드의 FIREBASE_PROJECT_ID와 같은 프로젝트여야 한다.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 아래 VITE_* 는 레거시 웹(Vite) 빌드 전용이며 React Native 앱은 사용하지 않는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:8080
