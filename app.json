{
  "expo": {
    "name": "ALLOG",
    "slug": "allog",
    "scheme": "allog",
    "version": "1.0.0",
    "icon": "./mobile/assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./mobile/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f6f3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.allog.app"
    },
    "android": {
      "package": "com.allog.app",
      "adaptiveIcon": {
        "foregroundImage": "./mobile/assets/android-icon-foreground.png",
        "monochromeImage": "./mobile/assets/android-icon-monochrome.png",
        "backgroundColor": "#f7f6f3"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "운동 인증 영상을 촬영하기 위해 카메라 접근이 필요합니다.",
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
